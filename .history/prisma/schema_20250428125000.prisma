generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  description String?
  status      String   @default("PENDING")
  createdAt DateTime @default(now())
}

model DailyTask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  date      DateTime
  completed Boolean

  @@unique([taskId, date])
}